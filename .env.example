# AFSR Math 환경변수 예시
# 실제 값은 절대 Git에 커밋하지 마세요. Vercel 대시보드에서 설정하세요.

# 앱 모드: local (로컬 저장소 MVP) | cloud (Supabase 연동)
NUXT_PUBLIC_APP_MODE=local

# Supabase (cloud 모드에서 필요)
NUXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NUXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Service Role Key — 서버 전용. 브라우저/Vercel 클라이언트 번들에 노출 금지
NUXT_SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
